CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_ESP32_S3_USB_OTG=y
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=2048
CONFIG_CTRL_TRANSFER_DATA_MAX_BYTES=2048
CONFIG_USB_HOST_HW_BUFFER_BIAS_IN=y
CONFIG_ESP_WIFI_SSID="Nokia123"
CONFIG_ESP_WIFI_PASSWORD="12345678"
CONFIG_ANALYZE_EGG_ENDPOINT="https:///analyze-egg"
CONFIG_HTTPD_MAX_REQ_HDR_LEN=4096
CONFIG_HTTPD_MAX_URI_LEN=2048
CONFIG_MANUAL_HTTP_SERVER_PORT=8001
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384